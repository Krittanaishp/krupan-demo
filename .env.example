# ตัวอย่างค่าตั้งค่า (ค่าตัวอย่างเท่านั้น) · scripts/seed_demo.py สร้างไฟล์ .env ให้เองพร้อม SECRET_KEY ที่สุ่มใหม่
# ถ้าจะสร้างเอง: คัดลอกเป็น .env แล้วสร้างค่าสุ่มด้วย
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
KRUPAN_SECRET_KEY=

# ที่อยู่ของระบบ (ใช้ในส่วน QR ซึ่งปิดอยู่)
BASE_URL=http://127.0.0.1:8000
QR_ENABLED=off

# demo ไม่มีงานสำรองข้อมูลตามเวลา
BACKUP_WARNING=off
